		"client": ["de.optools.OpTools"]
	},
	"mixins": [
		{ "config": "optools.mixins.json", "environment": "client" }
	],
	"depends": {
		"fabricloader": ">=0.16.10",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
